{
  "openapi": "3.1.0",
  "info": {
    "title": "Money Remittance API",
    "description": "Money remittance module.",
    "version": "0.0.1"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "tags": [],
  "components": {
    "securitySchemes": {
      "apiKey": { "type": "apiKey", "in": "header", "name": "x-api-key" }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "mobileNumber": { "type": "string", "example": "09212345678" }
        },
        "required": ["id", "mobileNumber"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": { 
              "code": { "type": "string" },
              "message": { "type": "string" }
            },
            "required": ["message"]
          }
        },
        "required": ["error"]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service availability",
            "content": {
              "text/plain": { "schema": { "type": "string", "example": "OK" } }
            }
          }
        }
      }
    }
  }
}
